---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import config from '../data/portfolio.config.ts';
import { generatedAt } from '../lib/projects.ts';
import { t, homePath, other, formatDate, type Lang } from '../i18n/index.ts';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of this same page in the other language. */
  altPath: string;
  image?: string | null;
}
const { lang, title, description, altPath, image } = Astro.props;
const d = t(lang);
const fullTitle = title ? `${title} · Krum (Krumqnkata)` : d.siteTitle;
const desc = description || d.siteDescription;
const canonical = new URL(Astro.url.pathname, config.siteUrl).href;
const alternate = new URL(altPath, config.siteUrl).href;
const home = homePath(lang);
const ogImage = image ? new URL(image, config.siteUrl).href : 'https://raw.githubusercontent.com/Krumqnkata/Krumqnkata/main/assets/header.svg';
const ws = d.os.workspaces;
const workspaces = [
  { n: 1, id: 'home', label: ws.home },
  { n: 2, id: 'projects', label: ws.projects },
  { n: 3, id: 'about', label: ws.about },
  { n: 4, id: 'activity', label: ws.activity },
  { n: 5, id: 'contact', label: ws.contact },
];
---
<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other(lang)} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(lang === 'en' ? Astro.url.pathname : altPath, config.siteUrl).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#161e0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fefae0" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'bg' ? 'bg_BG' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{d.os.skip}</a>
    <header class="topbar">
      <div class="inner">
        <a class="os-logo" href={home} aria-label="Krum — home">
          <img src="/favicon.svg" alt="" width="22" height="22" />
          <span class="user-host"><span>krum</span><span class="at">@</span><span class="host">stara-zagora</span></span>
        </a>
        <nav class="workspaces" aria-label={d.os.workspacesLabel}>
          {workspaces.map((w) => (
            <a href={`${home}#${w.id}`} data-ws={w.id} aria-label={`${w.n}: ${w.label}`}><b aria-hidden="true">{w.n}</b><span>{w.label}</span></a>
          ))}
        </nav>
        <div class="tray">
          <div data-game data-on={d.game.on} data-off={d.game.off} data-win={d.game.win}>
            <button class="tray-btn game-btn" type="button" aria-pressed="false" aria-label={d.game.on} title={d.game.help} data-game-toggle>
              <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="15" rx="3"/><path d="M4 11h16M8 21l1-3M16 21l-1-3"/></svg>
              <span class="glabel">{d.game.toggle}</span><span class="gscore" data-game-score hidden></span>
            </button>
          </div>
          <span class="clock" data-clock title={d.os.clock}></span>
          <a class="tray-btn" href={altPath} hreflang={other(lang)} lang={other(lang)} title={d.switchLabel} aria-label={d.switchLabel} data-lang-switch>{d.switchTo}</a>
          <button class="tray-btn theme-btn" type="button" aria-label={d.themeLabel} title={d.themeLabel} data-theme-toggle>
            <span class="moon"><Icon name="moon" /></span><span class="sun"><Icon name="sun" /></span>
          </button>
          <a class="tray-btn gh-btn" href={`https://github.com/${config.owner}`} aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="statusline">
      <div class="inner">
        <span><span class="tag">[krumos]</span> <em>{d.footer.tagline}</em></span>
        <span>
          {d.footer.rebuilt} {formatDate(generatedAt, lang, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
          · <a href={`https://github.com/${config.owner}/${config.owner}.github.io`}>{d.footer.source}</a>
        </span>
      </div>
    </footer>
    <p class="game-help" data-game-help role="status" hidden>{d.game.help}</p>
    <div class="game-pad" data-game-pad hidden>
      <button type="button" data-pad="left" aria-label="Left">◀</button>
      <button type="button" data-pad="right" aria-label="Right">▶</button>
      <button type="button" data-pad="jump" aria-label="Jump">▲</button>
    </div>
    <script>
      import '../scripts/game.ts';
    </script>
    <script is:inline define:vars={{ locale: d.locale }}>
      (function () {
        var btn = document.querySelector('[data-theme-toggle]');
        if (btn) btn.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
        // Keep the section anchor when switching language.
        var sw = document.querySelector('[data-lang-switch]');
        if (sw) sw.addEventListener('click', function () {
          if (location.hash) sw.setAttribute('href', sw.getAttribute('href').split('#')[0] + location.hash);
        });
        // Panel clock, Stara Zagora time.
        var clock = document.querySelector('[data-clock]');
        function tick() {
          try {
            clock.textContent = new Intl.DateTimeFormat(locale, { weekday: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Sofia' }).format(new Date());
          } catch (e) {}
        }
        if (clock) { tick(); setInterval(tick, 20000); }
        // Highlight the workspace of the section in view.
        var links = Array.prototype.slice.call(document.querySelectorAll('[data-ws]'));
        if (!('IntersectionObserver' in window)) return;
        var sections = links.map(function (a) { return document.getElementById(a.dataset.ws); }).filter(Boolean);
        if (!sections.length) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            links.forEach(function (a) {
              if (a.dataset.ws === e.target.id) a.setAttribute('aria-current', 'true');
              else a.removeAttribute('aria-current');
            });
          });
        }, { rootMargin: '-45% 0px -50% 0px' });
        sections.forEach(function (s) { io.observe(s); });
      })();
    </script>
  </body>
</html>
