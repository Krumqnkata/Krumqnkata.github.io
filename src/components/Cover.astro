---
// Project cover: the screenshot when there is one, generated art underneath
// (also shown automatically if the image fails to load).
import type { Project } from '../lib/projects.ts';
import { shotAlt } from '../lib/projects.ts';
import type { Lang } from '../i18n/index.ts';
interface Props { project: Project; lang: Lang; eager?: boolean; class?: string }
const { project: p, lang, eager = false, class: cls = '' } = Astro.props;
const title = p.title[lang];

const icons: Record<string, string> = {
  web: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  school: '<path d="m2 9 10-5 10 5-10 5Z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/>',
  desktop: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  games: '<rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 11v3M5.5 12.5h3M15 12h.01M18 13.5h.01"/>',
  tools: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4Z"/>',
  transit: '<rect x="4" y="3" width="16" height="15" rx="3"/><path d="M4 11h16M8 21l1-3M16 21l-1-3"/><circle cx="8" cy="14.5" r="1"/><circle cx="16" cy="14.5" r="1"/>',
};
const motif = p.slug.includes('transit') ? 'transit' : p.category;
const cmd = p.repos[0] ? `$ ./${p.repos[0].name}` : `$ open ${p.live.replace(/^https?:\/\//, '').replace(/\/$/, '')}`;
---
<div class={`media ${cls}`}>
  <div class="art" aria-hidden="true">
    {motif === 'transit' ? (
      <svg class="motif" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" fill="none" stroke-linecap="round" stroke-width="6">
        <path d="M-10 190 C 80 190, 90 90, 170 90 S 280 160, 410 60" stroke="#dda15e" />
        <path d="M-10 60 C 70 70, 120 170, 210 170 S 330 210, 410 200" stroke="#bc6c25" />
        <path d="M60 -10 C 70 80, 150 120, 160 260" stroke="#606c38" />
        {[[40,185],[170,90],[280,120],[110,110],[210,170],[330,195],[150,175]].map(([x, y]) => <circle cx={x} cy={y} r="8" fill="#fefae0" stroke="#283618" stroke-width="3" />)}
      </svg>
    ) : (
      <svg class="motif" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" fill="none" stroke="#dda15e" stroke-opacity=".35">
        {Array.from({ length: 9 }, (_, i) => <path d={`M0 ${30 + i * 26} H400`} stroke-dasharray={`${20 + (i * 37) % 60} 10 ${8 + (i * 13) % 30} 14`} />)}
      </svg>
    )}
    <div class="art-text">
      <span class="art-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[motif] || icons.tools} /></span>
      <strong>{title}</strong>
      <span class="cmd">{cmd}</span>
    </div>
  </div>
  {p.cover && (
    <img src={p.cover} alt={shotAlt(p, lang)} loading={eager ? 'eager' : 'lazy'} decoding="async" onerror="this.remove()" />
  )}
</div>
