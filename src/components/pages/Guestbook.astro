---
import Base from '../../layouts/Base.astro';
import Window from '../Window.astro';
import Prompt from '../Prompt.astro';
import config from '../../data/portfolio.config.ts';
import { t, prefix, other, type Lang } from '../../i18n/index.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const k = d.kos.pages.guestbook;
const g = config.giscus;
---
<Base lang={lang} title={k.title} description={k.lead} altPath={`${prefix(other(lang))}/guestbook/`}>
  <div class="wrap">
    <header class="page-head">
      <Prompt dir="~" cmd={k.cmd} />
      <h1>{k.title}</h1>
      <p>{k.lead}</p>
    </header>
    <Window title="~/guestbook — giscus" lang={lang}>
      <div class="giscus-wrap" data-giscus
        data-repo={g.repo} data-repo-id={g.repoId} data-category={g.category} data-category-id={g.categoryId}
        data-lang={lang} data-site={config.siteUrl}>
        <noscript><p>{k.notReady}</p></noscript>
      </div>
      <p class="mono" style="margin-top:16px;font-size:13px;color:var(--muted)">
        <a href={`https://github.com/${g.repo}/discussions/categories/${g.category.toLowerCase()}`} target="_blank" rel="noopener">GitHub Discussions</a>
        · <a href={`mailto:${config.email}`}>{config.email}</a>
      </p>
    </Window>
  </div>
  <script>
    // giscus: GitHub-Discussions-backed comments, themed with KrumOS colours.
    const box = document.querySelector<HTMLElement>('[data-giscus]');
    if (box) {
      const themeUrl = () => `${box.dataset.site}/giscus-${document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'}.css`;
      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.async = true;
      s.crossOrigin = 'anonymous';
      const attrs: Record<string, string> = {
        'data-repo': box.dataset.repo!, 'data-repo-id': box.dataset.repoId!, 'data-category': box.dataset.category!,
        'data-category-id': box.dataset.categoryId!, 'data-mapping': 'specific', 'data-term': 'Guestbook',
        'data-strict': '1', 'data-reactions-enabled': '1', 'data-emit-metadata': '0', 'data-input-position': 'top',
        'data-theme': themeUrl(), 'data-lang': box.dataset.lang!, 'data-loading': 'lazy',
      };
      for (const [k2, v] of Object.entries(attrs)) s.setAttribute(k2, v);
      box.append(s);
      // Follow the site theme.
      new MutationObserver(() => {
        const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
        frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: themeUrl() } } }, 'https://giscus.app');
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }
  </script>
</Base>
