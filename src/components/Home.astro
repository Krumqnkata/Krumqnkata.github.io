---
import Base from '../layouts/Base.astro';
import Hero from './sections/Hero.astro';
import Featured from './sections/Featured.astro';
import ClientWork from './ClientWork.astro';
import GitLog from './GitLog.astro';
import { featured, clientWork } from '../lib/projects.ts';
import { homePath, other, prefix, type Lang } from '../i18n/index.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} altPath={homePath(other(lang))} image={featured[0]?.cover} page="home">
  <Hero lang={lang} />
  <Featured lang={lang} />
  {clientWork.map((p) => <ClientWork project={p} lang={lang} />)}
  <section class="block" aria-label="git log">
    <div class="wrap">
      <GitLog lang={lang} limit={6} more={`${prefix(lang)}/activity/#gitlog`} />
    </div>
  </section>
</Base>
